# Caddy gets and renews the certificate for this name automatically. Point the
# domain's DNS at the VPS and open ports 80 and 443 first.
{$JOBHUNT_DOMAIN} {
	# Board pages and MCP replies are text and shrink well.
	encode zstd gzip
	header {
		# Browsers that have seen the site once refuse plain HTTP to it for a year.
		Strict-Transport-Security "max-age=31536000"
		X-Content-Type-Options nosniff
		-Server
	}
	# Uploads stop at 20 MB in jobhunt itself. This refuses bigger bodies before
	# they reach it.
	request_body {
		max_size 25MB
	}
	reverse_proxy jobhunt:8788
}
