# Caddy gets and renews the certificate for this name automatically. Point the
# domain's DNS at the VPS and open ports 80 and 443 first.
{$JOBHUNT_DOMAIN} {
	# Browsers that have seen the site once refuse plain HTTP to it for a year.
	header Strict-Transport-Security "max-age=31536000"
	reverse_proxy jobhunt:8788
}
