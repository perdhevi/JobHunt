# Starts the bundled Caddy for HTTPS. Remove this line if another proxy on the
# VPS already owns ports 80 and 443, and point that proxy at 127.0.0.1:8788.
COMPOSE_PROFILES=caddy

# The domain that points at this VPS. Connectors use https://<domain>/mcp.
JOBHUNT_DOMAIN=jobhunt.example.com

# The password for the board's sign-in page, and for connecting Claude or
# ChatGPT. At least 12 characters. Changing it signs every app and browser out.
JOBHUNT_AUTH_PASSWORD=

# Optional static bearer token, for clients that can send an Authorization
# header but can't do OAuth. At least 24 characters. Leave empty to disable.
JOBHUNT_REMOTE_TOKEN=

# Serve the board at https://<domain>/ behind the password. Set to false to
# reach it only through an SSH tunnel.
JOBHUNT_REMOTE_BOARD=true
