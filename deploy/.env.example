# The domain that points at this VPS. Connectors use https://<domain>/mcp.
JOBHUNT_DOMAIN=jobhunt.example.com

# The password the sign-in page asks for when you connect Claude or ChatGPT.
# At least 12 characters. Changing it signs every connected app out.
JOBHUNT_AUTH_PASSWORD=

# Optional static bearer token, for clients that can send an Authorization
# header but can't do OAuth. At least 24 characters. Leave empty to disable.
JOBHUNT_REMOTE_TOKEN=
